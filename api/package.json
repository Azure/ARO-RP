{
  "dependencies": {
    "@azure-tools/typespec-autorest": "^0.72.0",
    "@azure-tools/typespec-azure-core": "^0.72.0",
    "@azure-tools/typespec-azure-resource-manager": "^0.72.0",
    "@azure-tools/typespec-azure-rulesets": "^0.72.0",
    "@azure-tools/typespec-client-generator-core": "^0.72.0",
    "@azure-tools/typespec-go": "^0.17.4",
    "@azure-tools/typespec-python": "^0.63.6",
    "@typespec/http": "~1.16.0",
    "@typespec/openapi": "~1.16.0",
    "@typespec/rest": "~0.86.0",
    "@typespec/streams": "~0.86.0",
    "@typespec/versioning": "~0.86.0",
    "@typespec/xml": "~0.86.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "format": "tsp format \"**/*.tsp\"",
    "format-check": "tsp format --check \"**/*.tsp\"",
    "swagger": "tsp compile redhatopenshift/resource-manager/Microsoft.RedHatOpenShift/OpenShiftClusters/main.tsp --warn-as-error --emit @azure-tools/typespec-autorest",
    "go": "tsp compile redhatopenshift/resource-manager/Microsoft.RedHatOpenShift/OpenShiftClusters/client.tsp --warn-as-error --emit @azure-tools/typespec-go",
    "python": "tsp compile redhatopenshift/resource-manager/Microsoft.RedHatOpenShift/OpenShiftClusters/client.tsp --warn-as-error --emit @azure-tools/typespec-python",
    "examples": "oav generate-examples"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.16.0",
    "oav": "^4.0.4"
  },
  "overrides": {
    "@azure-tools/typespec-python": {
      "@azure-tools/typespec-autorest": "$@azure-tools/typespec-autorest",
      "@azure-tools/typespec-azure-core": "$@azure-tools/typespec-azure-core",
      "@azure-tools/typespec-azure-resource-manager": "$@azure-tools/typespec-azure-resource-manager",
      "@azure-tools/typespec-azure-rulesets": "$@azure-tools/typespec-azure-rulesets",
      "@azure-tools/typespec-client-generator-core": "$@azure-tools/typespec-client-generator-core",
      "@typespec/events": "~0.86.0",
      "@typespec/rest": "$@typespec/rest",
      "@typespec/sse": "~0.86.0",
      "@typespec/streams": "$@typespec/streams",
      "@typespec/versioning": "$@typespec/versioning",
      "@typespec/xml": "$@typespec/xml"
    }
  }
}
