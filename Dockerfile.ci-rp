ARG BUILDER_REGISTRY
ARG BUILDER_REPOSITORY=openshift-release-dev/golang-builder--partner-share
ARG BUILDER_TAG=rhel-9-golang-1.26-openshift-4.23
ARG REGISTRY
ARG REPOSITORY=ubi9/ubi-minimal
ARG TAG=latest
ARG ARO_VERSION

###############################################################################
# Compile the Golang RP code
###############################################################################
FROM ${BUILDER_REGISTRY}/${BUILDER_REPOSITORY}:${BUILDER_TAG} AS builder
ARG ARO_VERSION
LABEL aro-builder=true
USER root
WORKDIR /app
ENV GO_COMPLIANCE_INFO=0

# golang config and build steps
ENV GOPATH=/root/go
ENV GOFLAGS="-tags=containers_image_openpgp,exclude_graphdriver_btrfs,exclude_graphdriver_devicemapper"

COPY .bingo .bingo
RUN source .bingo/variables.env \
    # install bingo itself
    && make -f .bingo/Variables.mk ${BINGO} \
    # and all the tools it manages
    && ${BINGO} get -l
ENV PATH=$PATH:${GOPATH}/bin/

# Copy dependencies and source files
COPY go.mod go.sum ./
COPY swagger swagger
COPY hack hack
COPY cmd cmd
COPY pkg pkg
COPY test test

# Build RP and E2E test suite bins
RUN go build -ldflags "-X github.com/Azure/ARO-RP/pkg/util/version.GitCommit=${ARO_VERSION}" ./cmd/aro

RUN go test ./test/e2e/... -tags e2e,codec.safe -c -ldflags "-X github.com/Azure/ARO-RP/pkg/util/version.GitCommit=${ARO_VERSION}" -o e2e.test

# Additional tests
RUN cd pkg/api/ \
    && gotestsum --format pkgname --junitfile ../../reportapi.xml -- -coverpkg=./... -coverprofile=coverapi.out ./... \
    && gocov convert coverapi.out | gocov-xml > ../../coverageapi.xml \
    && cd ../..
RUN gotestsum --format pkgname --junitfile report.xml -- -coverpkg=./... -coverprofile=cover.out ./... \
    && gocov convert cover.out | gocov-xml > coverage.xml

# Validate FIPS
RUN hack/fips/validate-fips.sh ./aro

###############################################################################
# final is our slim image with minimal layers and tools
###############################################################################
FROM ${REGISTRY}/${REPOSITORY}:${TAG} AS final
LABEL aro-final=true
COPY --from=builder /app/aro /app/e2e.test /usr/local/bin/
COPY --from=builder /app/report.xml /app/coverage.xml /app/reportapi.xml /app/coverageapi.xml /app/
ENTRYPOINT ["aro"]
EXPOSE 2222/tcp 8080/tcp 8443/tcp 8444/tcp
USER 1000
ENV HOME=/tmp
