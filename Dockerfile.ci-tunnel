ARG BUILDER_REGISTRY
ARG BUILDER_REPOSITORY=openshift-release-dev/golang-builder--partner-share
ARG BUILDER_TAG=rhel-9-golang-1.26-openshift-4.23
ARG REGISTRY
ARG REPOSITORY=ubi9/ubi-minimal
ARG TAG=latest
ARG ARO_VERSION

FROM ${BUILDER_REGISTRY}/${BUILDER_REPOSITORY}:${BUILDER_TAG} AS builder
ARG ARO_VERSION
USER root
WORKDIR /app

# golang config and build steps
ENV GOPATH=/root/go
ENV GO_COMPLIANCE_INFO=0

# Copy dependencies and source files
COPY go.mod go.sum ./
COPY hack hack
COPY pkg pkg

# build
RUN go build -ldflags "-X github.com/Azure/ARO-RP/pkg/util/version.GitCommit=${ARO_VERSION}" ./hack/tunnel

FROM ${REGISTRY}/${REPOSITORY}:${TAG} AS final
COPY --from=builder /app/tunnel /usr/local/bin/
ENTRYPOINT ["tunnel"]
EXPOSE 8443/tcp
USER 1000
